.modal(data-modal-label="modal_feedback")
	.modal__bg
	.modal__wrap
		.modal__title Отправить заявку
		button(type="button").modal__close.js-close-modal
			<svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
				<path d="M5.6499 5.65L0.649902 0.65M5.6499 5.65L10.6499 10.65M5.6499 5.65L10.6499 0.65M5.6499 5.65L0.649902 10.65" stroke="#141414" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
			</svg>
		form(action="#").modal__form.js-form
			.field_set
				input(type="text" placeholder="ФИО").field_set__input.required
				span.error-message Это поле не может быть пустым
			.field_set
				input(type="text" placeholder="Телефон").field_set__input.js-phone-mask.required.required-phone
				span.error-message Это поле не может быть пустым
			.field_set
				input(type="text" placeholder="Наименование организации" data-validate="false").field_set__input
			.field_set
				textarea(placeholder="Комментарий" data-validate="false").field_set__textarea
			//label.field_upload
				input(type="file" data-validate="false")
				button(type="button").btn
					span Загрузить файл
					<svg width="23" height="23" viewBox="0 0 23 23" fill="none" xmlns="http://www.w3.org/2000/svg">
						<path d="M5.75 19.1667H17.25M11.5 15.1666C11.5 11.782 11.5 9.88447 11.5 6.49994M11.5 6.49994C12.8099 7.80982 13.5443 8.54422 14.8542 9.85411M11.5 6.49994C10.1901 7.80982 9.45572 8.54422 8.14583 9.85411" stroke="#00CB62" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
					</svg>
				span.text Допустимые форматы: doc, docx, pdf<br>Допустимый размер: не более 5 MB
				.field_upload__file
					span.field_upload__name
					button(type="button").field_upload__close
						<svg width="10" height="10" viewBox="0 0 10 10" fill="none" xmlns="http://www.w3.org/2000/svg">
							<path d="M4.6499 4.65002L8.6499 0.650024M4.6499 4.65002L0.649902 8.65002M4.6499 4.65002L8.6499 8.65002M4.6499 4.65002L0.649903 0.650024" stroke="white" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
						</svg>
			.input-file
				label.input-file__label(for="")
					input.input-file__input.js-file.js-file-doc(type="file" multiple)
					span.text Загрузить файл
					span.svg
						<svg xmlns="http://www.w3.org/2000/svg" width="23" height="23" viewBox="0 0 23 23" fill="none">
							<path d="M5.75 19.1667H17.25M11.5 15.1666C11.5 11.7821 11.5 9.88453 11.5 6.5M11.5 6.5C12.8099 7.80988 13.5443 8.54428 14.8542 9.85417M11.5 6.5C10.1901 7.80988 9.45572 8.54428 8.14583 9.85417" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
						</svg>
				span.input-file__wrapp
					span.input-file__info Допустимые форматы: doc, docx, pdf 
					span.input-file__info Допустимый размер: не более 5 MB
			.field_submit
				button(type="submit").btn_green Отправить заявку
			label.filed_checkbox
				input(type="checkbox" data-show-message="false").required.required-checkbox
				span.check
				span.text Нажимая отправить вы даёте согласие с <a href="#">политикой обработки персональных данных</a>
