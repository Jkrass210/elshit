  section.sect-leave-career
    .container
      .sect-leave-career__content
        h2.h2 Отправить резюме
        .form-type-1
          form.js-form(action="#")
            .form-type-1__container
              .form-type-1__group-field
                label.input-type-1(for="")
                  input.input-type-1__input.required(type="text" placeholder="Ваше имя")
                  span.error-message Это поле не может быть пустым
                label.input-type-1(for="")
                  input.input-type-1__input.required.js-phone-mask.required-phone(type="text" placeholder="Номер телефона")
                  span.error-message Это поле не может быть пустым
                label.input-type-1(for="")
                  input.input-type-1__input.required.required-mail(type="text" placeholder="E-mail")
                  span.error-message Это поле не может быть пустым
                label.textarea-type-1(for="")
                  textarea.textarea-type-1__text(name="" placeholder="Ваш отзыв")
                  span.error-message Это поле не может быть пустым
              .form-type-1__group-file
                .input-file
                  label.input-file__label(for="")
                    input.input-file__input.js-file.js-file-doc(type="file" multiple)
                    span.text Загрузить файл
                    span.svg
                      <svg xmlns="http://www.w3.org/2000/svg" width="23" height="23" viewBox="0 0 23 23" fill="none">
                        <path d="M5.75 19.1667H17.25M11.5 15.1666C11.5 11.7821 11.5 9.88453 11.5 6.5M11.5 6.5C12.8099 7.80988 13.5443 8.54428 14.8542 9.85417M11.5 6.5C10.1901 7.80988 9.45572 8.54428 8.14583 9.85417" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                  span.input-file__wrapp
                    span.input-file__info Допустимые форматы: doc, docx, pdf
                    span.input-file__info Допустимый размер: не более 5 MB
              .form-type-1__group-submit
                button.form-type-1__submit(type="submit")
                  span.text Отправить отзыв
                label.checkbox-type-1(for="")
                  input.checkbox-type-1__input.required.required-checkbox(type="checkbox" checked)
                  span.castom
                    <svg xmlns="http://www.w3.org/2000/svg" width="11" height="9" viewBox="0 0 11 9" fill="none">
                      <path d="M9.7002 0.699951L3.4002 8.19995L0.700195 5.19995" stroke="white" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  span.checkbox-type-1__desc Нажимая отправить вы даёте согласие с <a href="#">политикой обработки персональных данных</a>